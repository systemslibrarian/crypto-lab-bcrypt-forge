{
  "name": "crypto-lab-bcrypt-forge",
  "version": "1.0.0",
  "description": "Browser-based interactive bcrypt educational demo",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run test:publish-request && tsc && vite build",
    "preview": "vite preview",
    "test:a11y": "playwright test",
    "deploy": "gh workflow run deploy-pages.yml --repo systemslibrarian/crypto-lab-bcrypt-forge --ref main",
    "test:publish-request": "node --test tests/publish-request.node.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemslibrarian/crypto-lab-bcrypt-forge.git"
  },
  "keywords": [
    "cryptography",
    "bcrypt",
    "password-hashing",
    "security",
    "education"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/systemslibrarian/crypto-lab-bcrypt-forge/issues"
  },
  "homepage": "https://systemslibrarian.github.io/crypto-lab-bcrypt-forge/",
  "dependencies": {
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
